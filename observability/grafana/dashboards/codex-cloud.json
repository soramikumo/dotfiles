{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 20,
      "panels": [],
      "title": "Logs (Loki)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=~\"codex.*|Codex.*\"}[$__range]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Events",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=~\"codex.*|Codex.*\"} |~ \"(?i)(error|failed)\" [$__range]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Errors / failures",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (count_over_time({service_name=~\"codex.*|Codex.*\"}[$__auto]))",
          "legendFormat": "{{service_name}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Event rate by surface",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "{service_name=~\"codex.*|Codex.*\"} | json",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Codex structured events",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 21,
      "panels": [],
      "title": "Traces (Tempo)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempods}"
      },
      "description": "session_task.turn span の duration 分位（単位: 秒）。TraceQL metrics を使用。注1: TraceQL metrics は時間範囲の上限が 25h。now-7d などに広げるとこのパネルだけ HTTP 400 になる。注2: Tempo のヒストグラムは 2 の冪の指数バケットなので、値は 68.7s / 274.9s / 549.8s のように粗く量子化される。傾向を見る用途に限る。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempods}"
          },
          "limit": 20,
          "query": "{ resource.service.name =~ \"codex.*\" && name = \"session_task.turn\" } | quantile_over_time(duration, .5, .9, .99)",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "Turn duration p50 / p90 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempods}"
      },
      "description": "surface (service.name) ごとの span 生成レート。codex_cli_rs (TUI) / codex_exec (codex exec) などで分かれる。注: TraceQL metrics は時間範囲の上限が 25h。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "id": 12,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempods}"
          },
          "limit": 20,
          "query": "{ resource.service.name =~ \"codex.*\" } | rate() by (resource.service.name)",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "Span rate by surface",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempods}"
      },
      "description": "1 ターンあたりのトークン内訳。session_task.turn span の codex.turn.token_usage.* 属性を select() で列に出す。Tempo は属性を集計できないので一覧表示。トークン列が空の行は、そのターンで token_usage 属性が記録されていない（中断など）。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "codex.turn.token_usage.total_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "total"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "codex.turn.token_usage.input_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "input"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "codex.turn.token_usage.cached_input_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "cached in"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "codex.turn.token_usage.output_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "output"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "codex.turn.token_usage.reasoning_output_tokens"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "reasoning"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Trace Name"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "id": 13,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempods}"
          },
          "limit": 200,
          "query": "{ resource.service.name =~ \"codex.*\" && name = \"session_task.turn\" } | select(span.codex.turn.token_usage.total_tokens, span.codex.turn.token_usage.input_tokens, span.codex.turn.token_usage.cached_input_tokens, span.codex.turn.token_usage.output_tokens, span.codex.turn.token_usage.reasoning_output_tokens)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Token usage per turn (session_task.turn)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempods}"
      },
      "description": "MCP サーバの tool 一覧取得コスト。起動が遅いときの主犯になりやすい。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "id": 14,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempods}"
          },
          "limit": 200,
          "query": "{ resource.service.name =~ \"codex.*\" && name =~ \"list_tools.*|make_rmcp_client|plugins_for_config\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "MCP / plugin startup cost",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempods}"
      },
      "description": "500ms を超えた span。ボトルネック候補の入口。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "id": 15,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempods}"
          },
          "limit": 200,
          "query": "{ resource.service.name =~ \"codex.*\" && duration > 500ms }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Slow spans (> 500ms)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${tempods}"
      },
      "description": "conversation.id を入れると 1 セッション分を横断で拾える。Codex は 1 ターン = 1 トレースにならず複数トレースに割れるため、trace ではなく conversation.id で辿る。重要: conversation.id は span 属性ではなく span event 属性なので、TraceQL では span. ではなく event. を使う（/api/v2/search/tags の scope が event 側）。",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "id": 16,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${tempods}"
          },
          "limit": 300,
          "query": "{ resource.service.name =~ \"codex.*\" && event.conversation.id =~ \"$conversation\" }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Spans by conversation.id",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "codex",
    "otel",
    "grafana-cloud",
    "tempo"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "grafanacloud-logs",
          "value": "grafanacloud-logs"
        },
        "label": "Loki",
        "name": "datasource",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {
          "text": "grafanacloud-traces",
          "value": "grafanacloud-traces"
        },
        "label": "Tempo",
        "name": "tempods",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "label": "conversation.id",
        "name": "conversation",
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          }
        ],
        "query": ".*",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Codex Usage (Cloud)",
  "uid": "codex-cloud",
  "version": 5
}
