# このファイルを ~/.config/secrets.env にコピーして実際の値を記入する。
# 実体ファイル (secrets.env) は .gitignore でコミット対象外。
# .zprofile / .zshrc がこのファイルを source して環境変数を読み込む。
# OPENAI_API_KEY は ccgate (Claude Code / Codex の PermissionRequest フック) が利用する。

export OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Grafana Cloud OTLP 認証ヘッダ (Claude Code / Codex 共通。取得方法は observability/README.md 参照)
export GRAFANA_CLOUD_OTLP_HEADERS="Authorization=Basic <instanceID:トークン を base64 化した値>"

# 既定と異なる Grafana Cloud リージョンを使う場合だけ設定する。
# export CODEX_GRAFANA_CLOUD_OTLP_ENDPOINT="https://otlp-gateway-REGION.grafana.net/otlp"
